+
+document.getElementById('form-oferta-assinatura').addEventListener('submit', async (ev) => {
+  ev.preventDefault();
+  const linhas = (id) => document.getElementById(id).value.split('\n').map((l) => l.trim()).filter(Boolean);
+  const faq = linhas('oferta-faq').map((l) => {
