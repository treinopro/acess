+process.env.MERCADOPAGO_ASSINATURAS = '1';
+process.env.MERCADOPAGO_ACCESS_TOKEN = 'TESTE';
+delete process.env.MERCADOPAGO_WEBHOOK_SECRET;
+
+const { test, before, after } = require('node:test');
+const assert = require('node:assert');
+const fs = require('fs');
