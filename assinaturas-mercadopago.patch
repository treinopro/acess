+  @media (prefers-reduced-motion: reduce) {
+    .cta { animation: none; }
+    .beneficios li { animation: none; opacity: 1; transform: none; }
+  }
+</style>
+</head>
+<body>
+<main id="raiz" aria-live="polite">
+  <div class="estado"><div class="icone">⏳</div><p class="sub">Carregando sua oferta…</p></div>
+</main>
+
+<div class="cta-barra oculto" id="barra">
+  <div class="interno">
+    <a class="cta" id="cta" href="#" rel="noopener">Ativar pagamento automático →</a>
+    <p class="micro" id="micro"></p>
+  </div>
+</div>
+
+<script>
+(function () {
+  'use strict';
+  var raiz = document.getElementById('raiz');
+  var barra = document.getElementById('barra');
+  var cta = document.getElementById('cta');
+  var microEl = document.getElementById('micro');
+  var id = location.pathname.split('/').filter(Boolean).pop();
+  var voltouDoCartao = /[?&]retorno=1(&|$)/.test(location.search);
+
+  function brl(centavos) {
+    return (centavos / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
+  }
+
+  function el(tag, props, filhos) {
+    var n = document.createElement(tag);
+    Object.keys(props || {}).forEach(function (k) {
+      if (k === 'text') n.textContent = props[k];
+      else if (k === 'className') n.className = props[k];
+      else n.setAttribute(k, props[k]);
+    });
+    (filhos || []).forEach(function (f) { n.appendChild(typeof f === 'string' ? document.createTextNode(f) : f); });
+    return n;
+  }
+
+  function limpar() { while (raiz.firstChild) raiz.removeChild(raiz.firstChild); }
+
+  function estado(icone, titulo, texto, zap) {
+    limpar();
+    barra.classList.add('oculto');
+    var caixa = el('div', { className: 'estado' }, [
+      el('div', { className: 'icone', text: icone }),
+      el('h1', { text: titulo }),
+      el('p', { className: 'sub', text: texto }),
+    ]);
+    if (zap) caixa.appendChild(el('a', { className: 'link-zap', href: 'https://wa.me/' + zap, text: 'Falar com a recepção' }));
+    raiz.appendChild(caixa);
+  }
+
+  function precoCard(o) {
+    var meses = o.frequencia_meses || 1;
+    var porMes = o.valor_centavos / meses;
+    var porDia = o.valor_centavos / (meses * 30);
+    var rotulo = meses === 1 ? '/mês' : ' a cada ' + meses + ' meses';
+    var temDesconto = o.desconto_centavos > 0;
+    var filhos = [el('div', { className: 'plano', text: o.plano })];
+    if (temDesconto) filhos.push(el('div', { className: 'antes', text: 'De ' + brl(o.valor_cheio_centavos) }));
+    filhos.push(el('div', { className: 'valor' }, [el('strong', { text: brl(o.valor_centavos) }), el('span', { text: rotulo })]));
+    if (temDesconto) filhos.push(el('span', { className: 'eco', text: '🎉 Você economiza ' + brl(o.desconto_centavos) + (meses === 1 ? ' todo mês' : ' a cada cobrança') }));
+    filhos.push(el('span', { className: 'dia', text: 'Só ' + brl(Math.round(porDia)) + ' por dia para treinar' }));
+    if (meses > 1) filhos.push(el('p', { className: 'nota', text: 'Equivale a ' + brl(Math.round(porMes)) + ' por mês.' }));
+    return el('section', { className: 'preco' }, filhos);
+  }
+
+  // Título editável: {nome} vira o primeiro nome; *palavra* ganha destaque verde.
+  function tituloHtml(modelo, nome) {
+    var h1 = el('h1');
+    var texto = String(modelo || '').replace(/\{nome\}/g, nome || '').replace(/,\s*([!?.])/g, '$1').replace(/\s+([!?.,])/g, '$1');
+    texto.split(/(\*[^*]+\*)/).forEach(function (parte) {
+      if (!parte) return;
+      if (/^\*[^*]+\*$/.test(parte)) h1.appendChild(el('em', { text: parte.slice(1, -1) }));
+      else h1.appendChild(document.createTextNode(parte));
+    });
+    return h1;
+  }
+
+  function renderOferta(o) {
+    limpar();
+    var lista = el('ul', { className: 'beneficios' });
+    o.beneficios.forEach(function (b, i) {
+      var li = el('li', { text: b });
+      li.style.animationDelay = (0.08 * i + 0.1) + 's';
+      lista.appendChild(li);
+    });
+
+    if (o.preview) raiz.appendChild(el('div', { className: 'previa', text: 'PRÉVIA — é assim que o aluno vê (o botão não leva a lugar nenhum)' }));
+    raiz.appendChild(el('span', { className: 'selo', text: o.selo }));
+    raiz.appendChild(el('p', { className: 'academia', text: o.academia }));
+    raiz.appendChild(tituloHtml(o.titulo, o.aluno));
+    if (o.subtitulo) raiz.appendChild(el('p', { className: 'sub', text: o.subtitulo }));
+    raiz.appendChild(precoCard(o));
+    raiz.appendChild(el('h2', { text: 'O que você ganha' }));
+    raiz.appendChild(lista);
+
+    raiz.appendChild(el('h2', { text: 'Como funciona' }));
+    var passos = el('ol', { className: 'passos' });
+    [['Toque em ', 'o botão verde'], ['Cadastre o cartão ', 'no ambiente do Mercado Pago'], ['Pronto: ', 'a cobrança acontece sozinha']].forEach(function (p) {
+      var li = el('li');
+      li.appendChild(document.createTextNode(p[0]));
+      li.appendChild(el('b', { text: p[1] }));
+      passos.appendChild(li);
+    });
+    raiz.appendChild(passos);
+
+    if (o.faq && o.faq.length) {
+      raiz.appendChild(el('h2', { text: 'Dúvidas comuns' }));
+      o.faq.forEach(function (d) {
+        raiz.appendChild(el('details', {}, [el('summary', { text: d.p }), el('p', { text: d.r })]));
+      });
+    }
+
+    cta.textContent = o.botao;
+    cta.setAttribute('href', o.init_point);
+    if (o.preview) cta.addEventListener('click', function (ev) { ev.preventDefault(); });
+    microEl.textContent = o.microtexto || '';
+    barra.classList.remove('oculto');
+  }
+
+  function buscar() {
+    return fetch('/api/pagamentos/assinaturas/oferta/' + encodeURIComponent(id), { cache: 'no-store' })
+      .then(function (r) {
+        if (r.status === 404) return null;
+        if (!r.ok) throw new Error('falha');
+        return r.json();
+      });
+  }
+
+  function confirmarAtivacao(o, tentativa) {
+    // Voltou do Mercado Pago: o aviso (webhook) pode levar alguns segundos.
+    estado('⏳', 'Confirmando seu cadastro…', 'Só um instante, estamos finalizando.');
+    var timer = setInterval(function () {
+      tentativa += 1;
+      buscar().then(function (n) {
+        if (n && n.status === 'authorized') { clearInterval(timer); ativo(n); }
+        else if (tentativa >= 20) { clearInterval(timer); estado('✅', 'Recebemos seu cadastro!', 'A confirmação pode levar alguns minutos. Se tiver dúvida, fale com a recepção.', o.whatsapp_contato); }
+      }).catch(function () { /* tenta de novo */ });
+    }, 4500);
+  }
+
+  function ativo(o) {
+    estado('✅', 'Tudo certo, ' + (o.aluno || 'bom treino') + '!', 'Seu pagamento automático está ativo. Agora é só treinar — a mensalidade se resolve sozinha.', o.whatsapp_contato);
+  }
+
+  buscar().then(function (o) {
+    if (!o) return estado('🔎', 'Oferta não encontrada', 'Confira o link ou fale com a recepção.');
+    if (o.preview) return renderOferta(o);
+    if (o.status === 'authorized') return ativo(o);
+    if (o.status === 'cancelled') return estado('ℹ️', 'Esta oferta não está mais disponível', 'Fale com a recepção para gerar um novo link.', o.whatsapp_contato);
+    if (o.status === 'paused') return estado('⏸️', 'Assinatura pausada', 'Fale com a recepção para retomar.', o.whatsapp_contato);
+    if (voltouDoCartao) return confirmarAtivacao(o, 0);
+    if (!o.init_point) return estado('ℹ️', 'Link indisponível', 'Fale com a recepção para gerar um novo link.', o.whatsapp_contato);
+    renderOferta(o);
+  }).catch(function () {
+    estado('⚠️', 'Não foi possível carregar', 'Verifique sua conexão e tente de novo em instantes.');
+  });
+})();
+</script>
+</body>
+</html>
